{
  "enabled": true,
  "name": "Wording check on save",
  "description": "Gloam must never say a route is safe. Whenever app source changes, run the banned-word and wording tests so a slip is caught in seconds, not at the next checkpoint.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["app/src/**/*.ts", "app/index.html"]
  },
  "then": {
    "type": "runCommand",
    "command": "cd app && npx vitest --run tests/wording.test.ts tests/ownWording.test.ts tests/bannedWords.property.test.ts"
  }
}
